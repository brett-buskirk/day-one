{
  "name": "day-one",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "description": "Day One — a phone-first reentry simulator (React PWA).",
  "scripts": {
    "build:content": "node scripts/build-content.mjs",
    "icons": "node scripts/make-icons.mjs",
    "og": "node scripts/make-og-image.mjs",
    "predev": "npm run build:content",
    "dev": "vite",
    "prebuild": "npm run build:content",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run build:content",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.20.0",
    "js-yaml": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
